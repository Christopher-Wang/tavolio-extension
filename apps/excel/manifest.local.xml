<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tavolio for Excel, served by the Vite dev server (docker compose up app). ?host=excel makes the dev build use the
  workbook instead of the browser mock spreadsheet.
  Separate add-in Id from manifest.xml so both can be installed side by side.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>4b1d0c52-6f2e-4a63-9a57-3c0f6f1b8e21</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Tavolio</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Tavolio (local)"/>
  <Description DefaultValue="Local-first predictions for your spreadsheet. Your data never leaves the browser."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/?host=excel"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="ExcelApi" MinVersion="1.9"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/?host=excel"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Tavolio.Group">
                <Label resid="Tavolio.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Tavolio.Icon16"/>
                  <bt:Image size="32" resid="Tavolio.Icon32"/>
                  <bt:Image size="80" resid="Tavolio.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="Tavolio.Open">
                  <Label resid="Tavolio.ButtonLabel"/>
                  <Supertip>
                    <Title resid="Tavolio.ButtonLabel"/>
                    <Description resid="Tavolio.ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Tavolio.Icon16"/>
                    <bt:Image size="32" resid="Tavolio.Icon32"/>
                    <bt:Image size="80" resid="Tavolio.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>TavolioPane</TaskpaneId>
                    <SourceLocation resid="Tavolio.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Tavolio.Icon16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Tavolio.Icon32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Tavolio.Icon80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Tavolio.Url" DefaultValue="https://localhost:3000/?host=excel"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tavolio.GroupLabel" DefaultValue="Tavolio"/>
        <bt:String id="Tavolio.ButtonLabel" DefaultValue="Tavolio"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Tavolio.ButtonTip" DefaultValue="Open Tavolio to predict a column from your selected table."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
